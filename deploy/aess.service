# systemd user unit for the AESS generator.
#   cp deploy/aess.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now aess
#   loginctl enable-linger "$USER"   # keep it running after logout / start at boot
# Edit WorkingDirectory/ExecStart if the repo lives somewhere other than ~/aess.
[Unit]
Description=AESS generator website
After=network-online.target

[Service]
WorkingDirectory=%h/aess
ExecStart=/usr/bin/python3 %h/aess/server/app.py --host 0.0.0.0 --port 8000
Environment=AESS_SOLIDCRAFT_CLI=%h/.local/bin/solidcraft-cli
Environment=AESS_DATA=%h/aess-data
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
